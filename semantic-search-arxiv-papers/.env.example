# Copy this file to .env for local runs (never commit the real .env).
# On Streamlit Community Cloud these go under Settings -> Secrets instead.

# --- Qdrant Cloud (https://cloud.qdrant.io - free tier, no card) ---
# Cluster URL, looks like: https://xxxxxxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_URL=
# API key from the cluster's "Data Access Control" tab
QDRANT_API_KEY=
