# api.py only needs impl_vanilla/src, configs/, and shared/ -- everything
# else (impl_langchain, notebooks, .git, test caches) just slows the build
# and bloats the image for no reason.
.git/
impl_langchain/
impl_vanilla/notebooks/
impl_vanilla/tests/
shared/tests/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ipynb_checkpoints/
*.md
COMPARISON.md
