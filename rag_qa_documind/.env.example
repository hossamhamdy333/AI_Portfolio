GEMINI_API_KEY = Gemini API

GEMINI_MODEL=gemini-3.1-flash-lite

# Local embedding model (downloaded automatically, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where the vector database persists on disk
CHROMA_DB_DIR=./data/chroma_db
CHROMA_COLLECTION=documind

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=4

# Database: sqlite:///./dev.db for local dev (zero setup), or
# mssql+pyodbc://... for Azure SQL in production - see README.
DATABASE_URL=sqlite:///./dev.db

# Auth - generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth - FastAPI backend only, leave blank to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:8000
