# Get a FREE key (no credit card needed) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Model used for answer generation -- gemini-3.1-flash-lite is a stable,
# high-quota free-tier model. If it ever 404s (Google deprecates models
# fairly often), check https://ai.google.dev/gemini-api/docs/models for
# the current recommended replacement.
GEMINI_MODEL=gemini-3.1-flash-lite

# Local embedding model (downloaded automatically, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where the vector database persists on disk
CHROMA_DB_DIR=./data/chroma_db
CHROMA_COLLECTION=documind

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=4
