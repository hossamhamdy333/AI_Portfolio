# This is a template only.
# In the deployed app, set this in Settings -> Secrets in the Streamlit
# Community Cloud dashboard instead (paste this same format there).
#
# Visitors bring their own Gemini API key (entered in the app's sidebar),
# so there's nothing sensitive to put here. This file is only for an
# optional override of the default model.

# Optional: default Gemini model. Leave unset to use gemini-3.1-flash-lite.
# GEMINI_MODEL = "gemini-3.1-flash-lite"
