# This is a template only.
# In the deployed app, set this in Settings -> Secrets in the Streamlit
# Community Cloud dashboard instead (paste this same format there).
#
# This app uses ONE shared Gemini key (yours) for every visitor, so
# visitors never need their own key. A per-account daily question limit
# (DAILY_QUERY_LIMIT in streamlit_app.py) protects this key's quota from
# being drained by any single visitor.

# Required - the shared key every visitor's questions are answered with.
# Get a free one at https://aistudio.google.com/apikey
GEMINI_API_KEY = "your-actual-gemini-key"

# Required for accounts to work at all - password hashing needs this,
# even though this app never issues JWTs to itself.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY = "generate-a-real-random-value-for-this"

# Without this, accounts are stored in a local SQLite file that gets wiped
# on every redeploy - see README's "Accounts and a real database" section
# for how to set up a real Azure SQL Database instead.
# DATABASE_URL = "mssql+pyodbc://..."

# Optional: default Gemini model. Leave unset to use gemini-3.1-flash-lite.
# GEMINI_MODEL = "gemini-3.1-flash-lite"
