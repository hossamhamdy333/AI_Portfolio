# Copy this to .env for local dev, or set each of these individually under
# Azure Portal -> your App Service -> Configuration -> Application settings
# for production. Every variable below with no default in config.py is
# REQUIRED - the app will fail to start (crash on boot) without it.

# ---- Required, no default ----
GEMINI_API_KEY=
HF_TOKEN=
QDRANT_URL=
QDRANT_API_KEY=

# ---- Database ----
# Local dev (zero setup):
DATABASE_URL=sqlite:///./dev.db
# Production (Azure SQL) - looks like this instead:
# DATABASE_URL=mssql+pymssql://<user>:<password>@<server>.database.windows.net:1433/<db>

# ---- Auth ----
# MUST be a real random secret in production, never the default below.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-this-in-production

# ---- Optional: Azure Blob Storage (file uploads) ----
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=omnirag-documents

# ---- Optional: Google OAuth ("Continue with Google" button) ----
# Leave blank to disable - email/password login still works either way.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:8000

# ---- Optional: observability ----
ENABLE_OBSERVABILITY=false
PHOENIX_COLLECTOR_ENDPOINT=
