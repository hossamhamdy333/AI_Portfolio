# Copy this file to .env and fill in your own free API keys.
# NEVER commit the real .env file (it's already in .gitignore).

# --- Get free at https://aistudio.google.com/apikey ---
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Get free at https://huggingface.co/settings/tokens (read access is enough) ---
HF_TOKEN=your_hf_token_here

# --- Get free at https://cloud.qdrant.io (no card required) ---
QDRANT_URL=your_qdrant_cluster_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=azure-rag-assistant

# --- Azure Blob Storage. Leave blank until your Azure account is ready -
# the app just skips document archival gracefully until then (Qdrant
# still handles retrieval fine either way). Once you have a real Azure
# Storage account, get this from Azure Portal -> your Storage Account ->
# "Access keys" -> "Connection string". For local Docker dev only, you can
# instead use Azurite's fixed dev connection string - see docker-compose.yml.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=omnirag-documents

# --- Simple shared-secret header check (protects your public URL) ---
# Set any random string. Leave blank to disable (fine for local-only testing).
APP_API_KEY=change-me-to-a-random-string
