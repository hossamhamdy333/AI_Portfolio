GGUF_REPO=hossam3759180/support-copilot-gguf
GGUF_FILENAME=support-copilot-q4.gguf
GEMINI_API_KEY=
ENABLE_EVAL=0

# Inference backend: llamacpp (default, CPU) or vllm (GPU, higher throughput)
LLM_BACKEND=llamacpp
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=hossam3759180/support-copilot-merged

# Database: sqlite:///./dev.db for local dev (zero setup), or
# mssql+pyodbc://... for Azure SQL in production - see README.
DATABASE_URL=sqlite:///./dev.db

# Auth - generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth - leave blank to disable the "Continue with Google" button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:8000
