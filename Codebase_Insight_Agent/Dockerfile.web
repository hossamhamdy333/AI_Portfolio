FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY data/ data/
COPY static/ static/
COPY config.py .
COPY portfolio.py .
COPY database.py .
COPY models.py .
COPY auth.py .
COPY guardrails.py .
COPY rate_limit.py .
COPY web_app.py .

# GOOGLE_API_KEY, DATABASE_URL, and JWT_SECRET_KEY must be provided at
# container run/deploy time -- never baked into the image. See README's
# "The public website" section for what each one needs to be set to.
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["sh", "-c", "uvicorn web_app:app --host 0.0.0.0 --port ${PORT:-8000}"]
