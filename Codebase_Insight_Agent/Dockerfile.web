FROM python:3.12-slim

WORKDIR /app

# CPU-only torch keeps the image far smaller than the default CUDA build
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements-base.txt requirements-web.txt ./
RUN pip install --no-cache-dir -r requirements-web.txt

# Download the embedding model at build time so cold starts don't fetch it
COPY config.py .
RUN python -c "import config; from sentence_transformers import SentenceTransformer; SentenceTransformer(config.EMBEDDING_MODEL)"

COPY data/ data/
COPY static/ static/
COPY portfolio.py .
COPY database.py .
COPY models.py .
COPY auth.py .
COPY guardrails.py .
COPY rate_limit.py .
COPY web_app.py .

# GOOGLE_API_KEY, QDRANT_URL, QDRANT_API_KEY, DATABASE_URL and JWT_SECRET_KEY
# are set on the container at deploy time, never baked into the image.
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["sh", "-c", "uvicorn web_app:app --host 0.0.0.0 --port ${PORT:-8000}"]
