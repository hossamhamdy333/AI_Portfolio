# Copy this file to .env and fill in real values for local runs.
# In a container (Azure Container Apps etc.), set these as environment
# variables / secrets on the container instead of using a .env file.

# --- Required everywhere (notebooks, mcp_server.py, web_app.py) ---
GOOGLE_API_KEY=

# --- Persistent index (see README's "Provisioning the index") ---
# Leave both blank for quick local testing with an in-memory, non-persistent
# Qdrant instance. Set both for anything real - mcp_server.py and web_app.py
# will fail fast with a clear error if the index hasn't been provisioned yet.
QDRANT_URL=
QDRANT_API_KEY=

# --- mcp_server.py remote deployment only (README's "Remote deployment") ---
# Leave all three unset for local stdio use (Claude Desktop / Claude Code) -
# no token is needed or checked in that mode.
MCP_TRANSPORT=
MCP_ACCESS_TOKEN=
MCP_PUBLIC_URL=

# --- web_app.py (the public site) ---
# Without a real DATABASE_URL, the admin account and query log live in a
# local SQLite file that's wiped on every redeploy - fine for local dev,
# not for a real deployment. See README for the Azure SQL connection format.
DATABASE_URL=sqlite:///./dev.db
JWT_SECRET_KEY=dev-only-secret-change-this-in-production
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=3600

# --- Optional, if you re-add Azure Monitor tracing (see README's "Known gaps") ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
